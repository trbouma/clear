# Generate each required secret with: openssl rand -hex 32
CLEAR_MASTER_SECRET=
CLEAR_OPERATOR_TOKEN=

# Public URL encoded into tokens and advertised by the mint.
CLEAR_MINT_URL=http://127.0.0.1:3339

CLEAR_CURRENCY_NAME=Clear Lab Credit Program
CLEAR_CURRENCY_ALIAS=Clear Lab Credits
CLEAR_CURRENCY_UNIT_ALIAS=credits
CLEAR_MAX_ORDER=20
CLEAR_ROOT_AUTHORITY_NPUB=

# Docker runtime settings.
CLEAR_IMAGE=clear-mint:local
CLEAR_BIND_ADDRESS=0.0.0.0
CLEAR_PORT=3339
CLEAR_LOG_LEVEL=info

# Leave blank to use an ephemeral sender identity for each Clear Payment.
CLEAR_ROOT_NSEC=
# clear-root accepts only a loopback URL. Compose fixes this value inside the container.
CLEAR_ROOT_API_URL=http://127.0.0.1:3339

# Local non-Docker defaults. Compose overrides these with paths in its volume.
CLEAR_DATABASE=./data/clear.sqlite3
CLEAR_ROOT_WALLET=./data/clear-root-wallet.json
